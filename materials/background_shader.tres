[gd_resource type="Shader" format=3]

[resource]
code = "shader_type canvas_item;

float r(vec2 n) {
	return fract(cos(dot(n, vec2(36.26, 73.12))) * 354.63);
}

float noise(vec2 n) {
	vec2 fn = floor(n);
	vec2 sn = smoothstep(vec2(0.0), vec2(1.0), fract(n));
	float h1 = mix(r(fn), r(fn + vec2(1.0, 0.0)), sn.x);
	float h2 = mix(r(fn + vec2(0.0, 1.0)), r(fn + vec2(1.0)), sn.x);
	return mix(h1, h2, sn.y);
}

float perlin(vec2 n) {
	return noise(n / 32.0) * 0.5875
		+ noise(n / 16.0) * 0.2
		+ noise(n / 8.0) * 0.1
		+ noise(n / 4.0) * 0.05
		+ noise(n / 2.0) * 0.025
		+ noise(n) * 0.0125;
}

void fragment() {
	vec2 uv = FRAGCOORD.xy;
	uv.y -= TIME * 28.0;
	float v = perlin(uv * 0.45);
	v = smoothstep(0.42, 0.86, v);
	vec3 base = vec3(0.025, 0.075, 0.1);
	vec3 glow = vec3(0.04, 0.24, 0.28);
	COLOR = vec4(mix(base, glow, v), 1.0);
}
"
