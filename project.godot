; Engine configuration file.
; Godot 4.7 — portrait mobile port.

config_version=5

[application]

config/name="Clinkwell"
config/description="Portrait brick-breaker. Drag to move the paddle, tap to launch."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.03, 0.08, 0.11, 1)
boot_splash/show_image=false
config/icon="res://icons/icon.png"

[autoload]

global="*res://autoload/global.gd"
hsm="*res://autoload/hi_scores_manager.gd"
nc="*res://autoload/notification_center.gd"
options_manager="*res://autoload/options_manager.gd"
shots="*res://autoload/shots.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=420
window/size/window_height_override=900
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/subwindows/embed_subwindows=true
window/vsync/vsync_mode=1

[gui]

theme/custom="res://themes/main.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[internationalization]

locale/fallback="en"

[physics]

2d/default_gravity=0.0
common/physics_interpolation=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.08, 0.11, 1)
